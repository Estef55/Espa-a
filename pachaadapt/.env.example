# Copia este archivo como .env y agrega tu API key real solo en .env (nunca en este archivo).
# La clave permanece en el backend; el frontend no recibe este valor.
PACHAADAPT_AI_PROVIDER=groq
PACHAADAPT_AI_BASE_URL=https://api.groq.com/openai/v1
PACHAADAPT_AI_MODEL=llama-3.3-70b-versatile
PACHAADAPT_AI_API_KEY=
PACHAADAPT_AI_TIMEOUT=45
PACHAADAPT_AI_MAX_TOKENS=800
